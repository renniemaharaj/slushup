{
  "name": "slushup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "quality": "npm run check && npm test && npm run build && npm run test:e2e",
    "audit:performance": "node scripts/performance.mjs",
    "format": "prettier --write src tests scripts docs/*.md README.md *config.ts .prettierrc.json",
    "format:check": "prettier --check src tests scripts docs/*.md README.md *config.ts .prettierrc.json",
    "stage": "node scripts/package-stage.mjs",
    "release": "npm run quality && npm run stage"
  },
  "dependencies": {
    "@lucide/svelte": "^1.73.0",
    "bits-ui": "^2.21.0",
    "embla-carousel-svelte": "^8.6.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "svelte": "^5.57.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
